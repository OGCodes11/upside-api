# Copy to .env and fill in. Never commit .env.

# CollegeBasketballData.com key, for ingest only. The API server never needs it.
CBBD_API_KEY=

# Database the API reads. Defaults to data/upside.db.
# UPSIDE_DB_PATH=data/public.db

# Set to 1 on a public deployment: the raw /v1/players endpoints then need an X-API-Key header.
PUBLIC_MODE=
# The key those endpoints accept. With PUBLIC_MODE=1 and no key set, nobody gets in.
UPSIDE_API_KEY=
